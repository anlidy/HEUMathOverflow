RAG_APP_NAME=rag-service
RAG_APP_ENV=dev
RAG_APP_PORT=8090

RAG_OPENAI_API_KEY=<your-openai-api-key>
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_MODEL=gpt-4.1-mini
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=forum_knowledge

RAG_REDIS_URL=redis://localhost:6379/0
RAG_POSTGRES_DSN=postgresql+asyncpg://forum_service_user:forum_service_pass@localhost:5432/forum_db

RAG_RETRIEVAL_TOP_K=4
RAG_CHAT_HISTORY_LIMIT=12
RAG_CACHE_TTL_SECONDS=300
RAG_AGENT_VERBOSE=false
